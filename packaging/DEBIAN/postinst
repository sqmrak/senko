#!/bin/sh
# optional hooks must not leave dpkg half-configured when substrate is absent

PAYLOAD_ROOT=/var/jb
if [ -e /var/jb/.procursus_strapped ] || \
   [ -x /var/jb/basebin/launchctl ] || \
   [ -x /var/jb/usr/bin/dpkg ]; then
  JBROOT=/var/jb
else
  JBROOT=
fi
PLIST=${JBROOT}/Library/LaunchDaemons/com.senko.senkod.plist
if [ -d "${JBROOT}/usr/lib/TweakInject" ] && [ ! -d "${JBROOT}/Library/MobileSubstrate/DynamicLibraries" ]; then
  SUBSTRATE_DIR=${JBROOT}/usr/lib/TweakInject
elif [ -d /usr/lib/TweakInject ] && [ ! -d /Library/MobileSubstrate/DynamicLibraries ]; then
  SUBSTRATE_DIR=/usr/lib/TweakInject
else
  SUBSTRATE_DIR=${JBROOT}/Library/MobileSubstrate/DynamicLibraries
fi
SUBSTRATE_FILTER=${PAYLOAD_ROOT}/usr/lib/senkotlsfix/substrate-filter.plist
TLSFIX_DYLIB=${PAYLOAD_ROOT}/usr/lib/senkotlsfix.dylib
TLSFIX_DIR=${PAYLOAD_ROOT}/usr/lib/senkotlsfix
STATUS_DYLIB=${PAYLOAD_ROOT}/usr/lib/senkostatus.dylib
STATUS_PLIST=${PAYLOAD_ROOT}/usr/lib/senkostatus.plist
APP=${PAYLOAD_ROOT}/Applications/Senko.app
KILLALL=${JBROOT}/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/bin/killall
UICACHE=${JBROOT}/usr/bin/uicache
[ -x "$UICACHE" ] || UICACHE=/usr/bin/uicache
LAUNCHCTL=${JBROOT}/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=${JBROOT}/usr/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/usr/bin/launchctl
STATUS_STATE=/var/mobile/Library/Preferences/com.senko.status.state
AWG_ACTIVE=/var/run/senkod-amnezia.config
CFG=/var/root/Library/Preferences/senko.cfg
LEGACY_CFG=/var/mobile/Library/Preferences/senko.cfg

install_rootful_link() {
  source_path=$1
  target_path=$2
  [ -e "$source_path" ] || return 1
  mkdir -p "${target_path%/*}" || return 1
  if [ -e "$target_path" ] && [ ! -L "$target_path" ]; then
    rm -rf "$target_path" || return 1
  fi
  if [ -L "$target_path" ]; then
    rm -f "$target_path" || return 1
  fi
  ln -s "$source_path" "$target_path"
}

# rootful springboard requires the bundle on the system Applications volume.
# rootless jailbreaks register /var/jb/Applications with their own uicache
install_rootful_app_bundle() {
  [ -z "$JBROOT" ] || return 0
  source_path="${PAYLOAD_ROOT}/Applications/Senko.app"
  target_path=/Applications/Senko.app
  [ -d "$source_path" ] || return 0
  rm -rf "${target_path}.dpkg-new" 2>/dev/null || true
  cp -R "$source_path" "${target_path}.dpkg-new" || return 1
  : > "${target_path}.dpkg-new/.senko-rootful-copy"
  [ -L "$target_path" ] && rm -f "$target_path"
  rm -rf "$target_path" 2>/dev/null || true
  mv "${target_path}.dpkg-new" "$target_path" || return 1
  chown -R root:wheel "$target_path" 2>/dev/null || true
  chmod 755 "$target_path" "$target_path/senko" 2>/dev/null || true
  find "$target_path" -type f ! -name senko -exec chmod 644 {} + 2>/dev/null || true
  return 0
}

install_rootful_daemon_plist() {
  source_path="${PAYLOAD_ROOT}/Library/LaunchDaemons/com.senko.senkod.plist"
  target_path=/Library/LaunchDaemons/com.senko.senkod.plist
  [ -f "$source_path" ] || return 0
  mkdir -p "${target_path%/*}" 2>/dev/null || return 1
  temp_path="${target_path}.dpkg-new"
  rm -f "$temp_path" 2>/dev/null || true
  sed 's#<string>/var/jb/usr/bin/senkod</string>#<string>/usr/bin/senkod</string>#' \
    "$source_path" > "$temp_path" || return 1
  if [ -e "$target_path" ] || [ -L "$target_path" ]; then
    rm -f "$target_path" 2>/dev/null || return 1
  fi
  mv "$temp_path" "$target_path" || return 1
  chown root:wheel "$target_path" 2>/dev/null || true
  chmod 644 "$target_path" 2>/dev/null || true
  return 0
}

# senko before 3.0 shipped a setuid senko-kick, as a real copy in /usr/bin on
# rootful installs. senkod does that work itself now, and a stray setuid root
# binary must not outlive the package that needed it
remove_kick_leftovers() {
  for path in /usr/bin/senko-kick "${PAYLOAD_ROOT}/usr/bin/senko-kick"; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    rm -f "$path" 2>/dev/null || true
  done
  rm -f /var/log/senko-kick.log /var/tmp/senko-kick.lock \
    /var/mobile/Library/Preferences/Senko/kick.log 2>/dev/null || true
}

# senko before 3.0 ran amneziawg in its own senkoawgd process. senkod runs the
# tunnel now; an old one still up would hold a second utun and its routes.
# SIGTERM makes it take them down. the profile an upgrade asked to keep moves
# to the file senkod restores from
retire_senkoawgd() {
  if [ -f /var/run/senkoawgd.pid ]; then
    "$KILLALL" -TERM senkoawgd >/dev/null 2>&1 || true
    sleep 1
    "$KILLALL" -9 senkoawgd >/dev/null 2>&1 || true
  fi
  if [ -s /var/run/senkoawgd.upgrade ]; then
    profile="$(sed -n '1p' /var/run/senkoawgd.upgrade 2>/dev/null || true)"
    case "$profile" in
      /var/mobile/Library/Preferences/Senko/*.conf) printf '%s\n' "$profile" > "$AWG_ACTIVE" ;;
    esac
  fi
  rm -f /var/run/senkoawgd.pid /var/run/senkoawgd.status /var/run/senkoawgd.config \
    /var/run/senkoawgd.upgrade >/dev/null 2>&1 || true
  if [ -L /usr/bin/senkoawgd ] && [ "$(readlink /usr/bin/senkoawgd 2>/dev/null)" = "${PAYLOAD_ROOT}/usr/bin/senkoawgd" ]; then
    rm -f /usr/bin/senkoawgd
  fi
}

install_rootful_layout() {
  [ -z "$JBROOT" ] || return 0
  [ -x "${PAYLOAD_ROOT}/usr/bin/senkod" ] || return 1
  [ -s "${PAYLOAD_ROOT}/usr/lib/senko/cacert.pem" ] || return 1
  install_rootful_link "${PAYLOAD_ROOT}/usr/bin/senkod" "/usr/bin/senkod"
  [ "$(readlink /usr/bin/senkod)" = "${PAYLOAD_ROOT}/usr/bin/senkod" ] || return 1
  install_rootful_link "${PAYLOAD_ROOT}/usr/bin/senkoctl" "/usr/bin/senkoctl" || true
  install_rootful_link "${PAYLOAD_ROOT}/usr/lib/senkotlsfix.dylib" "/usr/lib/senkotlsfix.dylib" || true
  install_rootful_link "${PAYLOAD_ROOT}/usr/lib/senkotlsfix" "/usr/lib/senkotlsfix" || true
  install_rootful_link "${PAYLOAD_ROOT}/usr/lib/senko/cacert.pem" "/usr/lib/senko/cacert.pem"
  [ "$(readlink /usr/lib/senko/cacert.pem)" = "${PAYLOAD_ROOT}/usr/lib/senko/cacert.pem" ] || return 1
  install_rootful_link "${PAYLOAD_ROOT}/usr/lib/senkostatus.dylib" "/usr/lib/senkostatus.dylib" || true
  install_rootful_link "${PAYLOAD_ROOT}/usr/lib/senkostatus.plist" "/usr/lib/senkostatus.plist" || true
  install_rootful_daemon_plist || return 1
  [ -s /Library/LaunchDaemons/com.senko.senkod.plist ] || return 1
  if [ ! -e /usr/bin/head ] && [ -e "${PAYLOAD_ROOT}/usr/lib/senko/head" ]; then
    install_rootful_link "${PAYLOAD_ROOT}/usr/lib/senko/head" "/usr/bin/head" || true
  fi
}

# senko before 3.0 redirected traffic with pf or ipfw. a daemon that died under
# those versions left its rules loaded, and nothing in this version would take
# them out again
remove_firewall_leftovers() {
  if [ -f /var/run/senko-pf.conf ]; then
    for pfctl in /var/jb/sbin/pfctl /var/jb/usr/sbin/pfctl /sbin/pfctl /usr/sbin/pfctl; do
      [ -x "$pfctl" ] || continue
      "$pfctl" -q -a com.apple/senko -F all >/dev/null 2>&1 || true
      break
    done
    rm -f /var/run/senko-pf.conf >/dev/null 2>&1 || true
  fi
  for ipfw in /var/jb/sbin/ipfw /sbin/ipfw /usr/sbin/ipfw; do
    [ -x "$ipfw" ] || continue
    rule=12000
    while [ "$rule" -le 12098 ]; do
      "$ipfw" -q delete "$rule" >/dev/null 2>&1 || true
      rule=$((rule + 1))
    done
    break
  done
  # the link to the pf.os file this package no longer carries
  if [ -L /etc/pf.os ] && [ "$(readlink /etc/pf.os 2>/dev/null)" = "${PAYLOAD_ROOT}/etc/pf.os" ]; then
    rm -f /etc/pf.os
  fi
}

# rootful systems need a real system-volume bundle. Dopamine keeps its writable
# app bundles in /var/jb/Applications, because /Applications is sealed
install_rootful_app_bundle || {
  echo "senko: cannot place the app in /Applications" >&2
  exit 1
}
[ -z "$JBROOT" ] && APP=/Applications/Senko.app

# rootful systems need canonical links because armv7 code uses /usr paths
install_rootful_layout || {
  echo "senko: cannot place senkod, its TLS roots, or its launchd plist on rootful iOS" >&2
  exit 1
}
remove_firewall_leftovers || true
remove_kick_leftovers || true
retire_senkoawgd || true

# senkod runs xray from the packet tunnel extension binary. ios sandboxes any
# executable it starts from a path inside an app bundle, and xray then could
# not open its config ("operation not permitted"), so the same file gets a
# second name outside the bundle. a hard link, because a symlink resolves back
# into the bundle and a copy would cost another 25 MB
install_core_link() {
  core_exe="${PAYLOAD_ROOT}/Applications/Senko.app/PlugIns/SenkoTunnel.appex/SenkoTunnel"
  core_link="${PAYLOAD_ROOT}/usr/lib/senko-core"
  [ -x "$core_exe" ] || return 1
  rm -f "$core_link" 2>/dev/null || return 1
  ln "$core_exe" "$core_link"
}
install_core_link || {
  echo "senko: cannot link senko-core, the jailbreak tunnel will not start" >&2
  exit 1
}

# installation and removal must reach the same system launchd
. "${PAYLOAD_ROOT}/usr/lib/senko/launchd.sh" || exit 1

postinst_log() {
  echo "postinst: $*" >> /var/log/senko-system.log 2>/dev/null
}

# each line of stdin goes to the log under a label, so one failed start is readable in the
# app's log screen without a shell
postinst_log_lines() {
  label=$1
  while IFS= read -r line; do
    postinst_log "diag $label: $line"
  done
}

# senkod prints its usage and exits 2 when it gets no arguments, so running it that way
# shows whether the system lets the binary start at all: a kill by the code signature
# check shows as status 137, a missing library as dyld text
probe_senkod_exec() {
  path=$1
  [ -e "$path" ] || { postinst_log "diag exec $path: missing"; return 0; }
  reply="$("$path" 2>&1)"
  status=$?
  postinst_log "diag exec $path: status $status, $(printf '%s' "$reply" | sed -n '1p')"
}

# a launchd that lists senkod while the log stays empty never ran main(): the first line
# senkod writes comes before anything that can fail. this records the facts that tell the
# causes apart, none of them needs a shell on the device
diagnose_senkod() {
  postinst_log "diag system: $(uname -a 2>/dev/null)"
  postinst_log "diag cpu: $(sysctl -n hw.machine 2>/dev/null) subtype $(sysctl -n hw.cpusubtype 2>/dev/null)"
  postinst_log "diag files: $(ls -ld /usr/bin/senkod "${PAYLOAD_ROOT}/usr/bin/senkod" 2>&1 | tr '\n' ';')"
  launchctl_cmd list com.senko.senkod 2>&1 | postinst_log_lines launchctl
  probe_senkod_exec "${PAYLOAD_ROOT}/usr/bin/senkod"
  [ -z "$JBROOT" ] && probe_senkod_exec /usr/bin/senkod
  count=0
  for report in /var/mobile/Library/Logs/CrashReporter/senkod* /var/mobile/Library/Logs/CrashReporter/Retired/senkod*; do
    [ -e "$report" ] || continue
    postinst_log "diag crash report: $report"
    count=$((count + 1))
    [ "$count" -lt 3 ] || break
  done
}

# senkoctl exits non-zero for "STATE error", which is still an answer: a saved tunnel
# that failed to restore left every install half-configured
senkod_answers() {
  attempt=0
  while [ "$attempt" -lt 8 ]; do
    reply="$("${PAYLOAD_ROOT}/usr/bin/senkoctl" status 2>/dev/null)"
    case "$reply" in
      *"STATE "*) return 0 ;;
    esac
    attempt=$((attempt + 1))
    [ "$attempt" -lt 8 ] && sleep 1
  done
  return 1
}

# runs one launchctl form and keeps what it said when the job is still not listed,
# because ios 6 launchctl refuses a plist with a one line reason that was thrown away
launchd_attempt() {
  out="$(launchctl_cmd "$@" 2>&1)"
  status=$?
  launchd_loaded && return 0
  LAUNCHD_LAST_ERROR="$(printf '%s' "$out" | sed -n '1p')"
  postinst_log "diag launchctl $1: exit $status, $LAUNCHD_LAST_ERROR"
  return 1
}

# the session type a plist is judged against comes from the bootstrap launchctl runs in
diagnose_launchd_load() {
  postinst_log "diag session: uid $(id -ur 2>/dev/null), euid $(id -u 2>/dev/null), manager $(launchctl_cmd managername 2>&1 | sed -n '1p'), context ${LAUNCHCTL_CONTEXT}"
  postinst_log "diag plist: $(ls -ln "$PLIST" 2>&1)"
  postinst_log "diag env: LAUNCHD_SOCKET=${LAUNCHD_SOCKET:-unset} LaunchKeepContext=${LaunchKeepContext:-unset}"
  launchctl_cmd list 2>&1 | postinst_log_lines launchctl
}

launchd_load_and_kick() {
  launchd_attempt bootstrap system "$PLIST" || \
    launchd_attempt load -w "$PLIST" || \
    launchd_attempt load "$PLIST" || {
      diagnose_launchd_load
      return 1
    }
  launchctl_cmd enable system/com.senko.senkod >/dev/null 2>&1 || true
  launchctl_cmd kickstart -k system/com.senko.senkod >/dev/null 2>&1 || \
    launchctl_cmd start com.senko.senkod >/dev/null 2>&1 || true
  return 0
}

launchd_start() {
  if [ ! -x "$LAUNCHCTL" ]; then
    echo "senko: no launchctl found, senkod was not started" >&2
    return 1
  fi
  if ! select_launchctl_context; then
    echo "senko: launchctl cannot reach system launchd from this installer" >&2
    postinst_log "launchctl cannot reach system launchd"
    diagnose_launchd_load
    return 1
  fi
  if ! launchd_load_and_kick; then
    echo "senko: launchd did not load ${PLIST}, senkod is not running (${LAUNCHD_LAST_ERROR:-no launchctl output})" >&2
    postinst_log "launchd did not load ${PLIST}"
    return 1
  fi
  # the app shows this log, so a tester can see the step without a shell
  postinst_log "launchd holds com.senko.senkod"
  # launchctl can list a job whose process exits before it opens the socket
  if senkod_answers; then
    postinst_log "senkod answered STATUS"
    return 0
  fi
  postinst_log "senkod did not answer STATUS after launchd load"
  diagnose_senkod
  return 2
}

# cydia reads finish requests from the descriptor named first in $CYDIA
request_reboot() {
  fd=${CYDIA%% *}
  case "$fd" in
    ''|*[!0-9]*) return 0 ;;
  esac
  eval "printf 'finish:reboot\n' >&$fd" 2>/dev/null || true
}

# launchd still holds the job it loaded at boot, and KeepAlive starts the new
# /usr/bin/senkod once the old process exits. a changed plist waits for the reboot
launchd_restart_in_place() {
  postinst_log "launchctl has no launchd socket, load and unload fail until reboot"
  old_pid="$(launchd_job_pid)" || {
    echo "senko: launchd cannot load senkod until the device reboots" >&2
    postinst_log "senkod starts at the next boot"
    request_reboot
    return 3
  }
  case "$old_pid" in
    *[!0-9]*|'') ;;
    *) kill -TERM "$old_pid" 2>/dev/null || true ;;
  esac
  attempt=0
  while [ "$attempt" -lt 15 ]; do
    pid="$(launchd_job_pid)"
    case "$pid" in
      *[!0-9]*|''|"$old_pid") ;;
      *) break ;;
    esac
    attempt=$((attempt + 1))
    sleep 1
  done
  if [ "$attempt" -lt 15 ] && senkod_answers; then
    postinst_log "KeepAlive restarted senkod as pid ${pid}, senkod answered STATUS"
    return 0
  fi
  postinst_log "KeepAlive did not bring back an answering senkod after pid ${old_pid}"
  diagnose_senkod
  return 2
}

tlsfix_installed() {
  dpkg -s com.tlsfix >/dev/null 2>&1 && return 0
  [ -e "${SUBSTRATE_DIR}/tlsfix.dylib" ] && return 0
  return 1
}

substrate_installed() {
  [ -d "${JBROOT}/Library/MobileSubstrate/DynamicLibraries" ] && return 0
  [ -d "${JBROOT}/usr/lib/TweakInject" ] && return 0
  [ -d /Library/MobileSubstrate/DynamicLibraries ] && return 0
  [ -d /usr/lib/TweakInject ] && return 0
  [ -e "${JBROOT}/Library/MobileSubstrate/MobileSubstrate.dylib" ] && return 0
  [ -e "${JBROOT}/usr/lib/libsubstrate.dylib" ] && return 0
  [ -e "${JBROOT}/usr/lib/libsubstitute.dylib" ] && return 0
  [ -e "${JBROOT}/usr/lib/libhooker.dylib" ] && return 0
  [ -e "${JBROOT}/usr/lib/libellekit.dylib" ] && return 0
  [ -e /Library/MobileSubstrate/MobileSubstrate.dylib ] && return 0
  [ -e /usr/lib/libsubstrate.dylib ] && return 0
  [ -e /usr/lib/libsubstitute.dylib ] && return 0
  [ -e /usr/lib/libhooker.dylib ] && return 0
  [ -e /usr/lib/libellekit.dylib ] && return 0
  return 1
}

firmware_major() {
  version="$(sed -n '/<key>ProductVersion<\/key>/{n;s/.*<string>\([0-9][0-9]*\)\..*<\/string>.*/\1/p;q;}' \
    /System/Library/CoreServices/SystemVersion.plist 2>/dev/null)"
  if [ -z "$version" ]; then
    version="$(sed -n 's/.*<string>\([0-9][0-9]*\)\..*<\/string>.*/\1/{p;q;}' \
      /System/Library/CoreServices/SystemVersion.plist 2>/dev/null)"
  fi
  if [ -z "$version" ]; then
    # SystemVersion.plist is a binary plist on some builds and the sed above
    # reads nothing. the kernel version is always readable: darwin 15 and later
    # run six versions ahead of the ios major, and below that it is a table.
    # guessing 6 here injected the legacy tls shim on ios 12, which is the one
    # system the branches below exist to keep it off
    darwin="$(uname -r 2>/dev/null | sed -n 's/^\([0-9][0-9]*\)\..*/\1/p')"
    case "$darwin" in
      11|12) version=5 ;;
      13) version=6 ;;
      14) version=7 ;;
      "") ;;
      *) [ "$darwin" -ge 15 ] 2>/dev/null && version=$((darwin - 6)) ;;
    esac
  fi
  [ -n "$version" ] || version=6
  printf '%s\n' "$version"
}

disable_senkotlsfix_hooks() {
  rm -f "${SUBSTRATE_DIR}/senkotlsfix.dylib"
  rm -f "${SUBSTRATE_DIR}/senkotlsfix.plist"
  remove_senkod_injection
}

disable_senkostatus_hooks() {
  rm -f "${SUBSTRATE_DIR}/senkostatus.dylib"
  rm -f "${SUBSTRATE_DIR}/senkostatus.plist"
}

remove_rootful_legacy_links() {
  [ -L /usr/lib/senkotlsfix.dylib ] && rm -f /usr/lib/senkotlsfix.dylib || true
  [ -L /usr/lib/senkotlsfix ] && rm -f /usr/lib/senkotlsfix || true
  [ -L /usr/lib/senkostatus.dylib ] && rm -f /usr/lib/senkostatus.dylib || true
  [ -L /usr/lib/senkostatus.plist ] && rm -f /usr/lib/senkostatus.plist || true
}

remove_modern_legacy_payload() {
  # ios 12+ needs no injected tls shim or status hook; senkod's roots stay
  # under /usr/lib/senko
  rm -f "$TLSFIX_DYLIB" "$STATUS_DYLIB" "$STATUS_PLIST"
  rm -rf "$TLSFIX_DIR"
}

remove_senkod_injection() {
  if [ -f "$PLIST" ]; then
    skip=0
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        *'<key>EnvironmentVariables</key>'*) skip=1; continue ;;
      esac
      if [ "$skip" = 1 ]; then
        case "$line" in
          *'</dict>'*) skip=0 ;;
        esac
        continue
      fi
      printf '%s\n' "$line"
    done < "$PLIST" > "$PLIST.tmp" && mv "$PLIST.tmp" "$PLIST"
  fi
}

enable_senkotlsfix_hooks() {
  [ -f "${SUBSTRATE_FILTER}" ] || return 0
  mkdir -p "${SUBSTRATE_DIR}" || return 0
  ln -sf "${TLSFIX_DYLIB}" "${SUBSTRATE_DIR}/senkotlsfix.dylib" || return 0
  cp "${SUBSTRATE_FILTER}" "${SUBSTRATE_DIR}/senkotlsfix.plist" || return 0
  chown root:wheel "${SUBSTRATE_DIR}/senkotlsfix.plist" || true
  chmod 644 "${SUBSTRATE_DIR}/senkotlsfix.plist" || true
  remove_senkod_injection
}

enable_senkostatus_hooks() {
  [ -f "${STATUS_DYLIB}" ] || return 0
  [ -f "${STATUS_PLIST}" ] || return 0
  mkdir -p "${SUBSTRATE_DIR}" || return 0
  ln -sf "${STATUS_DYLIB}" "${SUBSTRATE_DIR}/senkostatus.dylib" || return 0
  cp "${STATUS_PLIST}" "${SUBSTRATE_DIR}/senkostatus.plist" || return 0
  chown root:wheel "${SUBSTRATE_DIR}/senkostatus.plist" || true
  chmod 644 "${SUBSTRATE_DIR}/senkostatus.plist" || true
}

chown root:wheel "$PLIST" || true
chmod 644 "$PLIST" || true

for bin in "${PAYLOAD_ROOT}/usr/bin/senkod" "${PAYLOAD_ROOT}/usr/bin/senkoctl"; do
  [ -e "$bin" ] && chown root:wheel "$bin" && chmod 755 "$bin" || true
done
# the obsolete helper would compete for the local proxy port
rm -f "${JBROOT}/usr/bin/redsocks-senko" "${PAYLOAD_ROOT}/usr/bin/redsocks-senko" /var/run/senko-redsocks.conf >/dev/null 2>&1 || true
[ -e "$TLSFIX_DYLIB" ] && chown root:wheel "$TLSFIX_DYLIB" && chmod 755 "$TLSFIX_DYLIB" || true
[ -e "$STATUS_DYLIB" ] && chown root:wheel "$STATUS_DYLIB" && chmod 755 "$STATUS_DYLIB" || true
[ -e "$STATUS_PLIST" ] && chown root:wheel "$STATUS_PLIST" && chmod 644 "$STATUS_PLIST" || true
mkdir -p "${TLSFIX_DIR}/roots" || true

IOS_MAJOR="$(firmware_major)"
if [ "$IOS_MAJOR" -ge 12 ] 2>/dev/null; then
  # modern ios has system tls and native status handling, so these hooks only add crash surface
  disable_senkotlsfix_hooks
  disable_senkostatus_hooks
  remove_rootful_legacy_links
  remove_modern_legacy_payload
elif tlsfix_installed; then
  disable_senkotlsfix_hooks
  enable_senkostatus_hooks
elif substrate_installed; then
  enable_senkotlsfix_hooks
  enable_senkostatus_hooks
else
  disable_senkotlsfix_hooks
  disable_senkostatus_hooks
fi

mkdir -p /var/mobile/Library/Preferences || true
printf '0\n' > "$STATUS_STATE" 2>/dev/null || true
chown mobile:mobile "$STATUS_STATE" >/dev/null 2>&1 || true
chmod 644 "$STATUS_STATE" >/dev/null 2>&1 || true
[ -e /var/mobile/Library/Preferences/com.senko.senkotlsfix.plist ] && \
  chown mobile:mobile /var/mobile/Library/Preferences/com.senko.senkotlsfix.plist && \
  chmod 644 /var/mobile/Library/Preferences/com.senko.senkotlsfix.plist || true
mkdir -p "${TLSFIX_DIR}/roots" || true
chown -R root:wheel "$TLSFIX_DIR" || true
chmod 755 "$TLSFIX_DIR" "${TLSFIX_DIR}/roots" || true
chmod 644 "${TLSFIX_DIR}"/roots/*.pem >/dev/null 2>&1 || true
chmod 644 "${TLSFIX_DIR}/cacert.pem" >/dev/null 2>&1 || true
if [ ! -s /var/log/senko-system.log ]; then
  [ -s /var/log/senkod.log ] && sed 's/^/[senkod] /' /var/log/senkod.log >> /var/log/senko-system.log
  [ -s /var/log/senkoawgd.log ] && sed 's/^/[awg] /' /var/log/senkoawgd.log >> /var/log/senko-system.log
fi
touch /var/log/senko-system.log >/dev/null 2>&1 || true
# the log outlives reinstalls, so lines from an older senkod read as the
# current one's; a marker shows where this install begins
installed="$(dpkg-query -W -f='${Version}' com.senko.daemon 2>/dev/null || true)"
printf 'postinst: senko %s installed\n' "${installed:-unknown}" >> /var/log/senko-system.log 2>/dev/null || true
chown root:mobile /var/log/senko-system.log >/dev/null 2>&1 || true
chmod 640 /var/log/senko-system.log >/dev/null 2>&1 || true
touch /var/log/senkotlsfix.log >/dev/null 2>&1 || true
chown root:mobile /var/log/senkotlsfix.log >/dev/null 2>&1 || true
chmod 660 /var/log/senkotlsfix.log >/dev/null 2>&1 || true
# the app runs as mobile and must expose installer failures in its update screen
touch /tmp/senko-update.log >/dev/null 2>&1 || true
chown root:mobile /tmp/senko-update.log >/dev/null 2>&1 || true
chmod 640 /tmp/senko-update.log >/dev/null 2>&1 || true

if [ -d "$APP" ]; then
  chown -R root:wheel "$APP" || true
  chmod 755 "$APP" || true
  chmod 755 "$APP/senko" || true
fi

mkdir -p /var/root/Library/Preferences || true
if [ ! -s "$CFG" ]; then
  if [ -s "$LEGACY_CFG" ] && [ ! -h "$LEGACY_CFG" ]; then
    cp "$LEGACY_CFG" "$CFG"
  else
    cat > "$CFG" <<'EOF'
V1
SET socks_port 11080
SET socks_public 0
SET dns_upstream 8.8.8.8
SET dns_local_port 10053
SEL -1
EOF
  fi
fi
chown root:wheel "$CFG" >/dev/null 2>&1 || true
chmod 600 "$CFG" >/dev/null 2>&1 || true

# senkod --update restarts the daemon itself once dpkg returns
if [ "${SENKO_UPDATE:-0}" != "1" ]; then
  if [ -x "$LAUNCHCTL" ] && select_launchctl_context && launchd_socket_lost; then
    launchd_restart_in_place
    start_rc=$?
  else
    # SIGTERM lets senkod remove routes before launchd starts the replacement
    launchd_stop || {
      postinst_log "cannot unload senkod before restarting it"
      diagnose_launchd_load
      exit 1
    }
    "$KILLALL" -TERM senkod >/dev/null 2>&1 || true
    sleep 1
    "$KILLALL" -TERM senkod >/dev/null 2>&1 || true
    sleep 1
    "$KILLALL" -9 senkod >/dev/null 2>&1 || true
    rm -f /var/tmp/senkod.sock /var/tmp/senkod.token

    # senkod brings a recorded amneziawg profile back by itself
    launchd_start
    start_rc=$?
  fi
  # 2 is a job launchd holds that has not answered yet. KeepAlive starts it again, so
  # the package is installed and the app and the log say what is missing; failing here left
  # dpkg half-configured on a taurine ios 14 install, which blocks every later install.
  # 3 is a plist launchd will load at the next boot
  case $start_rc in
    0) ;;
    2) echo "senko: senkod is loaded but did not answer yet; see /var/log/senko-system.log" >&2 ;;
    3) echo "senko: reboot the device to start senkod" >&2 ;;
    *)
      echo "senko: senkod was not loaded by launchd; see /var/log/senko-system.log" >&2
      exit 1
      ;;
  esac
fi

echo "Senko installed successfully. control socket: /var/tmp/senkod.sock"

# ios 7 and older keep the app list in mobile's installation cache, and their
# uicache run as root stops at "cannot open cache file. incorrect user?".
# newer uicache needs root, so root stays the fallback
INSTALL_CACHE=/var/mobile/Library/Caches/com.apple.mobile.installation.plist
SU=/bin/su
[ -x "$SU" ] || SU=/usr/bin/su
refresh_app_cache() {
  if [ -z "$JBROOT" ] && [ -f "$INSTALL_CACHE" ] && [ -x "$SU" ]; then
    "$SU" - mobile -c "$UICACHE -p $APP" && return 0
    "$SU" - mobile -c "$UICACHE" && return 0
  fi
  "$UICACHE" -p "$APP" || "$UICACHE"
}

# a tester on taurine (ios 14) lost userland to the watchdog while dpkg configured
# this package, and two things in the old tail were suspect there (not confirmed on a
# device): uicache ran in the background and the respring cut it off two seconds later,
# and backboardd was killed with SIGKILL, which makes launchd reboot userspace, which a
# jailbreak of that range does not survive. from ios 12 uicache finishes first, and from
# ios 14 only SpringBoard is restarted
if [ "$IOS_MAJOR" -ge 12 ] 2>/dev/null; then
  refresh_app_cache >/dev/null 2>&1 </dev/null || true
else
  # backgrounding avoids an ios 6 uicache deadlock while the old app is alive
  ( refresh_app_cache >/dev/null 2>&1 || true ) </dev/null &
fi

if [ "${SENKO_SKIP_RESPRING:-0}" = "1" ]; then
  exit 0
fi

# delaying respring lets dpkg record the configured state first
if [ "$IOS_MAJOR" -ge 14 ] 2>/dev/null; then
  ( sleep 2; "$KILLALL" -9 SpringBoard >/dev/null 2>&1 || true ) </dev/null >/dev/null 2>&1 &
else
  ( sleep 2; "$KILLALL" -9 SpringBoard backboardd >/dev/null 2>&1 || true ) </dev/null >/dev/null 2>&1 &
fi

exit 0
