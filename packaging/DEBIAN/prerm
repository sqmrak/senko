#!/bin/sh
# removal must continue after optional jailbreak tools disappear

if [ -e /var/jb/.procursus_strapped ] || \
   [ -x /var/jb/basebin/launchctl ] || \
   [ -x /var/jb/usr/bin/dpkg ]; then
  JBROOT=/var/jb
else
  JBROOT=
fi
PLIST=${JBROOT}/Library/LaunchDaemons/com.senko.senkod.plist
KICK=/var/jb/usr/bin/senko-kick
SENKOCTL=/var/jb/usr/bin/senkoctl
KILLALL=${JBROOT}/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/bin/killall
LAUNCHCTL=${JBROOT}/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=${JBROOT}/usr/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/bin/launchctl
[ -x "$LAUNCHCTL" ] || LAUNCHCTL=/usr/bin/launchctl
STATUS_STATE=/var/mobile/Library/Preferences/com.senko.status.state
AWG_ACTIVE_CONFIG=/var/run/senkoawgd.config
UPDATE_AWG_MARKER=/var/run/senkoawgd.upgrade
PF_CONF=/var/run/senko-pf.conf

awg_is_up() {
  [ -x "$KICK" ] || return 1
  status="$("$KICK" --awg-status 2>/dev/null || true)"
  case "$status" in
    connecting*|connected*) return 0 ;;
  esac
  return 1
}

remember_awg_for_upgrade() {
  [ "$1" = upgrade ] || return 0
  [ -s "$AWG_ACTIVE_CONFIG" ] || return 0
  config="$(sed -n '1p' "$AWG_ACTIVE_CONFIG" 2>/dev/null || true)"
  case "$config" in
    /var/mobile/Library/Preferences/Senko/*.conf)
      printf '%s\n' "$config" > "$UPDATE_AWG_MARKER"
      ;;
  esac
}

# routes, the pf anchor and the utun belong to the daemon, and dpkg deletes the
# binaries that know how to undo them moments after this script returns. asking
# the daemon to disconnect while it is still on disk is the only clean teardown;
# removing the package over a live tunnel used to leave the device with a
# default route into a utun nobody owned any more, and nothing left installed
# could turn it off again
stop_tunnel() {
  if awg_is_up; then
    remember_awg_for_upgrade "$1"
    "$KICK" --awg-stop >/dev/null 2>&1 || true
  fi
  if [ -S /var/tmp/senkod.sock ] && [ -x "$SENKOCTL" ]; then
    "$SENKOCTL" DISCONNECT >/dev/null 2>&1 || true
  fi
}

stop_daemon() {
  if [ -x "$LAUNCHCTL" ]; then
    "$LAUNCHCTL" bootout "system/com.senko.senkod" >/dev/null 2>&1 || \
      "$LAUNCHCTL" bootout system "$PLIST" >/dev/null 2>&1 || \
      "$LAUNCHCTL" unload "$PLIST" >/dev/null 2>&1 || true
    "$LAUNCHCTL" remove com.senko.senkod >/dev/null 2>&1 || true
  fi
  # SIGTERM lets senkod drop routes and rules before it exits
  "$KILLALL" -TERM senkod >/dev/null 2>&1 || true
  sleep 1
  "$KILLALL" -TERM senkod >/dev/null 2>&1 || true
  sleep 1
  "$KILLALL" -9 senkod senkoawgd >/dev/null 2>&1 || true
  # the go core holds the tunnel descriptor; the kernel drops every route bound
  # to that utun as soon as the last descriptor closes
  "$KILLALL" -9 senko-core >/dev/null 2>&1 || true
}

# only for a daemon that was already dead or wedged when this ran: the anchor is
# senko's own and an empty one is exactly what a clean teardown leaves
flush_pf_anchor() {
  [ -f "$PF_CONF" ] || return 0
  for pfctl in /var/jb/sbin/pfctl /var/jb/usr/sbin/pfctl /sbin/pfctl /usr/sbin/pfctl; do
    [ -x "$pfctl" ] || continue
    "$pfctl" -q -a com.apple/senko -F all >/dev/null 2>&1 || true
    break
  done
  rm -f "$PF_CONF" >/dev/null 2>&1 || true
}

if [ "${SENKO_UPDATE:-0}" != "1" ]; then
  stop_tunnel "$1"
  stop_daemon
  flush_pf_anchor
fi

printf '0\n' > "$STATUS_STATE" 2>/dev/null || true

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  # plain removal preserves user servers for a later reinstall
  rm -f /var/tmp/senkod.sock /var/tmp/senkod.token >/dev/null 2>&1 || true
  rm -f "$AWG_ACTIVE_CONFIG" "$UPDATE_AWG_MARKER" >/dev/null 2>&1 || true
fi

exit 0
