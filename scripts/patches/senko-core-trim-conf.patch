+//go:build !senko_trim
+
+package conf
+
+// the protocols a senko_trim build leaves out; a full build registers them
+// here so the loaders in xray.go keep their upstream behaviour
+func init() {
+	for id, creator := range map[string]ConfigCreator{
+		"tunnel":        func() interface{} { return new(DokodemoConfig) },
+		"dokodemo-door": func() interface{} { return new(DokodemoConfig) },
+		"vmess":         func() interface{} { return new(VMessInboundConfig) },
+		"wireguard":     func() interface{} { return &WireGuardConfig{IsClient: false} },
+	} {
+		inboundConfigLoader.cache[id] = creator
+	}
+	for id, creator := range map[string]ConfigCreator{
+		"loopback":  func() interface{} { return new(LoopbackConfig) },
+		"dns":       func() interface{} { return new(DNSOutboundConfig) },
+		"wireguard": func() interface{} { return &WireGuardConfig{IsClient: true} },
+	} {
+		outboundConfigLoader.cache[id] = creator
+	}
+}
