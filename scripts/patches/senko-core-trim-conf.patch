+//go:build senko_trim
+
+package conf
+
+import (
+	"github.com/xtls/xray-core/common/errors"
+	"google.golang.org/protobuf/proto"
+)
+
+// senko_trim builds carry only what senko's generated config uses
+// (daemon/senko_core_config.c). a config that still names one of these
+// top level sections fails to build instead of starting without it
+
+func errTrimmed(section string) error {
+	return errors.New(`"`, section, `" is not built into senko-core`)
+}
+
+type DNSConfig struct{}
+
+func (*DNSConfig) Build() (proto.Message, error) { return nil, errTrimmed("dns") }
