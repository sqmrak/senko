+// senkod only hands senko-core aes-gcm and chacha20 shadowsocks nodes; a 2022
+// cipher falls through to cipherFromString, which rejects it by name
+func isShadowsocks2022(string) bool { return false }
+
+func buildShadowsocks2022(*ShadowsocksServerConfig) (proto.Message, error) {
+	return nil, errTrimmed("shadowsocks 2022")
+}
+
+func buildShadowsocks2022Client(*ShadowsocksServerTarget) (proto.Message, error) {
+	return nil, errTrimmed("shadowsocks 2022")
+}
