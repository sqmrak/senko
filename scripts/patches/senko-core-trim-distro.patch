diff --git a/main/distro/senko/senko.go b/main/distro/senko/senko.go
new file mode 100644
index 00000000..0a8986a9
--- /dev/null
+++ b/main/distro/senko/senko.go
@@ -0,0 +1,63 @@
+// package senko registers only the xray-core features senko actually drives.
+//
+// daemon/senko_core_config.c is the only writer of senko-core's config, and it only
+// ever emits: a "tun" inbound, one outbound (vless or vmess over tcp/ws/grpc/xhttp
+// with tls/reality, trojan, aead shadowsocks, hysteria2 with an optional
+// salamander mask and port hopping, or a plain socks/http fallback), a "freedom"
+// direct outbound, a "blackhole" block outbound, and field routing rules by
+// domain or ip. senko-core is invoked as "run -c <file>.json", nothing else.
+//
+// main/distro/all additionally links the vmess inbound, wireguard, dokodemo,
+// loopback, kcp, httpupgrade, dns/fakedns/geodata, and the full
+// commander/observatory/reverse/metrics/stats/toml/yaml/remote-config stack,
+// none of which senko ever configures. infra/conf still imports those unless
+// the build sets the senko_trim tag (scripts/patches/senko-core-trim-conf.patch)
+package senko
+
+import (
+	// mandatory: build inbound/outbound handlers and dispatch traffic
+	_ "github.com/xtls/xray-core/app/dispatcher"
+	_ "github.com/xtls/xray-core/app/proxyman/inbound"
+	_ "github.com/xtls/xray-core/app/proxyman/outbound"
+
+	// senko_core_config.c always emits a top-level "log" block and "routing" rules
+	_ "github.com/xtls/xray-core/app/log"
+	_ "github.com/xtls/xray-core/app/router"
+
+	// fixes a dependency cycle caused by core import in the internet package
+	_ "github.com/xtls/xray-core/transport/internet/tagged/taggedimpl"
+
+	// proxies senko_core_config.c can emit: tun inbound, the vless, vmess,
+	// trojan, shadowsocks, hysteria and plain socks/http outbounds, freedom
+	// direct, blackhole block
+	_ "github.com/xtls/xray-core/proxy/blackhole"
+	_ "github.com/xtls/xray-core/proxy/freedom"
+	_ "github.com/xtls/xray-core/proxy/http"
+	_ "github.com/xtls/xray-core/proxy/hysteria"
+	_ "github.com/xtls/xray-core/proxy/shadowsocks"
+	_ "github.com/xtls/xray-core/proxy/socks"
+	_ "github.com/xtls/xray-core/proxy/trojan"
+	_ "github.com/xtls/xray-core/proxy/tun"
+	_ "github.com/xtls/xray-core/proxy/vless/inbound"
+	_ "github.com/xtls/xray-core/proxy/vless/outbound"
+	_ "github.com/xtls/xray-core/proxy/vmess/outbound"
+
+	// transports network_name() in senko_core_config.c can produce, plus their
+	// security settings
+	_ "github.com/xtls/xray-core/transport/internet/finalmask/salamander"
+	_ "github.com/xtls/xray-core/transport/internet/grpc"
+	_ "github.com/xtls/xray-core/transport/internet/hysteria"
+	_ "github.com/xtls/xray-core/transport/internet/reality"
+	_ "github.com/xtls/xray-core/transport/internet/splithttp"
+	_ "github.com/xtls/xray-core/transport/internet/tcp"
+	_ "github.com/xtls/xray-core/transport/internet/tls"
+	_ "github.com/xtls/xray-core/transport/internet/udp"
+	_ "github.com/xtls/xray-core/transport/internet/websocket"
+
+	// senko-core is only ever run with "-c config.json"
+	_ "github.com/xtls/xray-core/main/json"
+
+	// confloader/external.ConfigLoader is what reads the -c path from disk;
+	// without it confloader.LoadConfig falls back to reading stdin instead
+	_ "github.com/xtls/xray-core/main/confloader/external"
+)
