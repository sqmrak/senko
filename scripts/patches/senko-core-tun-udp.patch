+func (c *udpConn) write(payload []byte, dst net.Destination) error {
+	if len(payload) > 65527 || (c.src.Address.Family().IsIPv4() && len(payload) > 65507) {
+		return errors.New("tun UDP reply exceeds the IP datagram limit")
