+func (c *udpConn) nextPacket() (*packet, error) {
+	for {
+		select {
+		case <-c.done:
+			return nil, io.EOF
+		default:
+		}
+		c.deadlineMu.Lock()
+		deadline := c.readDeadline
+		idle := c.lastActivity.Add(c.handler.idleTimeout)
+		idleFirst := deadline.IsZero() || idle.Before(deadline)
+		if idleFirst {
+			deadline = idle
+		}
+		changed := c.deadlineChanged
+		c.deadlineMu.Unlock()
+		left := time.Until(deadline)
+		if left <= 0 {
+			if idleFirst {
+				c.Close()
+			}
+			return nil, os.ErrDeadlineExceeded
+		}
+		timer := time.NewTimer(left)
+		select {
+		case <-c.done:
+			timer.Stop()
+			return nil, io.EOF
+		case e := <-c.egress:
+			timer.Stop()
+			c.handler.Lock()
+			c.queuedBytes -= len(e.data)
+			c.handler.queuedBytes -= len(e.data)
+			c.handler.Unlock()
+			c.activity()
+			return e, nil
+		case <-changed:
+			timer.Stop()
+		case <-timer.C:
+			// a new deadline or packet may have extended the idle deadline
+		}
+	}
 }
 
